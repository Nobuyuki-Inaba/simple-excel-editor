{
  "name": "simple-excel-editor",
  "displayName": "Simple Excel Editor",
  "description": "Edit Excel files directly in VSCode with a spreadsheet-like interface",
  "version": "0.1.0",
  "publisher": "nobuyuki-inaba",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nobuyuki-Inaba/simple-excel-editor.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "excel",
    "xlsx",
    "csv",
    "spreadsheet",
    "editor"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "simpleExcelEditor.editor",
        "displayName": "Simple Excel Editor",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.xlsm"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "simpleExcelEditor.openSettings",
        "title": "Simple Excel Editor: 設定を開く"
      }
    ],
    "configuration": {
      "title": "Simple Excel Editor",
      "properties": {
        "simpleExcelEditor.javaPath": {
          "type": "string",
          "default": "",
          "description": "Javaの実行ファイルパス。空の場合はVSCode Java拡張またはJAVA_HOMEから自動検出します。"
        },
        "simpleExcelEditor.jarPath": {
          "type": "string",
          "default": "",
          "description": "exceltocsv JARファイルのパス。空の場合は拡張機能の lib/ フォルダのJARを使用します。"
        },
        "simpleExcelEditor.nullMarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "[null]"
          ],
          "description": "NULLとして扱う文字列。DBRider の ReplacementDataSet と合わせる場合は [null] を使用します。"
        },
        "simpleExcelEditor.emptyMarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "[empty]"
          ],
          "description": "空文字列として扱う文字列。DBRider の ReplacementDataSet と合わせる場合は [empty] を使用します。"
        },
        "simpleExcelEditor.encoding": {
          "type": "string",
          "enum": [
            "UTF-8"
          ],
          "enumDescriptions": [
            "UTF-8 (BOMなし)"
          ],
          "default": "UTF-8",
          "description": "CSV変換時の文字エンコーディング。"
        },
        "simpleExcelEditor.pageSize": {
          "type": "number",
          "default": 200,
          "minimum": 50,
          "maximum": 2000,
          "description": "1ページに表示する行数。"
        },
        "simpleExcelEditor.hasHeader": {
          "type": "boolean",
          "default": true,
          "description": "最初の行をヘッダ行として扱います。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsc -watch -p tsconfig.build.json",
    "test": "mocha",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "mocha": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
